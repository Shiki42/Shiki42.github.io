@article{hu2026ctr,
  abbr={ICLR},
  title={Learn the Task, Not the Schedule: Reducing Spurious Cross-Arm Coupling in Bimanual Imitation Learning},
  author={Hu, Shuyuan and Wu, Deng-Ke and Jin, Yifan and Luo, Qianhang and Ju, Mingchen and Ye, Kai and Zhao, Bo},
  year={2026},
  selected={true},
  highlight={true},
  preview={ctr.png},
  pdf={CTR_ICLR2027.pdf},
  note={Submitted to ICLR 2027.},
  abstract={Constraint-preserving Temporal Recombination (CTR) broadens the schedules seen during bimanual imitation learning while preserving recorded arm-local behavior and task-required cross-arm constraints. Evaluations with Diffusion Policy, ACT, and pi0.5 on simulated and real-robot tasks show reduced spurious cross-arm coupling while retaining necessary coordination.}
}

